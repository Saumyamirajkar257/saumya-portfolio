# Frontend environment variables  (frontend/.env.local)
# Copy to .env.local and adjust for your machine.

# Base URL of the FastAPI backend.
# Keep this pointing at localhost:8000 in development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL — used in SEO/OG tags, the sitemap, and analytics.
#   - Local dev: http://localhost:3000
#   - Production (VERCEL): set this to your real domain, e.g. https://saumyamirajkar.dev
#
# If NEXT_PUBLIC_SITE_URL is NOT set in a production build, the site falls
# back to the URL Vercel injects (VERCEL_PROJECT_PRODUCTION_URL) so the social
# preview can never regress to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000