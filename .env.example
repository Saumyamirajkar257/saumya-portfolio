# ============================================================
#  Portfolio — environment variable reference
#  Copy per-side env files:
#    backend/.env      (copy from backend/.env.example)
#    frontend/.env.local  (copy from frontend/.env.local.example)
#  See README.md for full setup + deployment instructions.
# ============================================================

# --- Backend (backend/.env) ---
# ENV=development
# DATABASE_URL=sqlite:///./portfolio.db
# JWT_SECRET_KEY=change-me-jwt-secret
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-admin-password
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=portfolio@example.com
# CONTACT_TO=saumyamirajkar25@icloud.com

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000