# ============================================================
#  Backend environment variables  (backend/.env)
#  Copy to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# Environment: development | production
ENV=development
DEBUG=true

# --- Database ---------------------------------------------------------------
# Local development (SQLite):
DATABASE_URL=sqlite:///./portfolio.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://portfolio_user:PASSWORD@localhost:5432/portfolio

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth / Admin ------------------------------------------------------------
# CHANGE THESE before going to production. The admin password is hashed
# with bcrypt at runtime — plaintext is never stored.
JWT_SECRET_KEY=change-me-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_ROLE=admin

# --- Contact form / Email (SMTP) ---------------------------------------------
# Leave SMTP_* empty for local development — messages are stored in the DB
# and logged. Configure these in production to actually receive emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portfolio@example.com
SMTP_USE_TLS=true
# Where the contact form email is delivered:
CONTACT_TO=saumyamirajkar25@icloud.com

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=300

# --- Frontend ----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000